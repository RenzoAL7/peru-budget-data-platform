# Copia este archivo a .env. Nunca subas .env al repositorio.
DATA_DIR=./data
DUCKDB_MEMORY_LIMIT=12GB
DUCKDB_THREADS=4
# 2007 y 2008 usan otro clasificador presupuestal y no traen codigos de proyecto.
FIRST_YEAR=2009

# OCI Object Storage por su API compatible con S3.
# La clave se crea en OCI: Perfil > Customer Secret Keys.
S3_ENDPOINT_URL=https://<namespace>.compat.objectstorage.us-ashburn-1.oraclecloud.com
S3_REGION=us-ashburn-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=gasto-publico-peru

# Cloudflare Pages.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT=peru-budget-data-platform

# Alertas opcionales de Airflow.
ALERT_WEBHOOK_URL=
